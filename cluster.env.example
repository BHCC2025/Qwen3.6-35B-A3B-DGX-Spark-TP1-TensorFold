# cluster.env — describe YOUR Spark. ./setup.sh writes the detected values for you; cluster.env is git-ignored.
# Shell syntax: this file is sourced by bash. A variable set in the environment overrides it for one run.

# ---- nodes ------------------------------------------------------------------------------------------
# SSH name of the Spark. TP1 uses NODES[0], the machine you run ./run.sh on.
NODES=(spark1)

# ---- model --------------------------------------------------------------------------------------------
# Local NVMe path of the checkpoint (./setup.sh downloads it here).
MODEL_DIR=/var/tmp/models/Qwen3.6-35B-A3B-MLX-4bit-MTP

# ---- serving ------------------------------------------------------------------------------------------
PORT=8000
SERVED_NAMES="qwen3.6-35b-a3b"                  # space-separated: the first is the model id, the rest are aliases
CONTAINER_NAME=tf_qwen36_35b
CACHE_DIR=/var/tmp/qwen36-35b-tensorfold-cache   # TensorFold's compiled kernels and prompt snapshots

# ---- memory profile -------------------------------------------------------------------------------------
# auto (default) reads /proc/meminfo: 64 below 80 GiB, else 128. 64 = PARALLEL=4, CONTEXT=65536 (startup estimate
# 34.7 GiB); 128 = PARALLEL=8, CONTEXT=auto. PARALLEL / CONTEXT set here or in the environment win over the profile.
#MEM_GB=64
